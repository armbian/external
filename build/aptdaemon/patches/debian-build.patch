Build on Debian.
Drop dh-translations and the test-only python3-nose.
Use importlib.metadata in place of pkg_resources. Debian testing has no
python3-pkg-resources.

diff --git a/aptdaemon/worker/__init__.py b/aptdaemon/worker/__init__.py
index a8f5fc8..28186b9 100644
--- a/aptdaemon/worker/__init__.py
+++ b/aptdaemon/worker/__init__.py
@@ -22,9 +22,8 @@ __author__ = "Sebastian Heinlein <devel@glatzor.de>"
 __all__ = ("BaseWorker", "DummyWorker")
 
 import logging
-import os
-import pkg_resources
 import time
+from importlib.metadata import entry_points
 import traceback
 
 from gi.repository import GObject, GLib
@@ -185,22 +184,18 @@ class BaseWorker(GObject.GObject):
         return False
 
     def _load_plugins(self, plugins, entry_point="aptdaemon.plugins"):
-        """Load the plugins from setuptools' entry points."""
-        plugin_dirs = [os.path.join(os.path.dirname(__file__), "plugins")]
-        env = pkg_resources.Environment(plugin_dirs)
-        dists, errors = pkg_resources.working_set.find_plugins(env)
-        for dist in dists:
-            pkg_resources.working_set.add(dist)
+        """Load the plugins from the entry points."""
+        # Armbian: importlib.metadata replaces pkg_resources. Debian
+        # testing has no python3-pkg-resources.
         for name in plugins:
-            for ept in pkg_resources.iter_entry_points(entry_point,
-                                                       name):
+            for ept in entry_points(group=entry_point, name=name):
                 try:
                     self.plugins.setdefault(name, []).append(ept.load())
                 except:
                     log.critical("Failed to load %s plugin: "
-                                 "%s" % (name, ept.dist))
+                                 "%s" % (name, ept.value))
                 else:
-                    log.debug("Loaded %s plugin: %s", name, ept.dist)
+                    log.debug("Loaded %s plugin: %s", name, ept.value)
 
     def _simulate_transaction(self, trans):
         """This method needs to be implemented by the backends."""
