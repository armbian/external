#!/usr/bin/make -f
# Repack the upstream release that matches the tag. Its SHA256 must match
# the checksums file of the same release.
include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

PKG = debian/armbian-netbird
ASSET = netbird_$(DEB_VERSION_UPSTREAM)_linux_$(DEB_HOST_ARCH).tar.gz
RELEASE = https://github.com/netbirdio/netbird/releases/download/v$(DEB_VERSION_UPSTREAM)

%:
	dh $@

override_dh_auto_build:
	curl -fsSL --retry 3 -o debian/$(ASSET) $(RELEASE)/$(ASSET)
	curl -fsSL --retry 3 -o debian/checksums.txt $(RELEASE)/netbird_$(DEB_VERSION_UPSTREAM)_checksums.txt
	cd debian && grep "  $(ASSET)$$" checksums.txt | sha256sum -c -
	mkdir -p debian/package
	tar -xzf debian/$(ASSET) -C debian/package --no-same-owner

override_dh_auto_install:
	install -D -m755 debian/package/netbird $(PKG)/usr/bin/netbird
	install -D -m644 debian/package/LICENSE $(PKG)/usr/share/doc/armbian-netbird/LICENSE
	install -D -m644 debian/package/LICENSES/BSD-3-Clause.txt $(PKG)/usr/share/doc/armbian-netbird/BSD-3-Clause.txt

override_dh_installsystemd:
	dh_installsystemd --name=netbird

override_dh_auto_configure override_dh_auto_test:

# Upstream binary: keep it as released.
override_dh_strip override_dh_dwz:

override_dh_auto_clean:
	rm -rf debian/package debian/*.tar.gz debian/checksums.txt
