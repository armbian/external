#!/usr/bin/make -f
# Upstream CMake build of the two Mesa SPIR-V targets, with clang-22 and
# llvm-spirv-22. The result matches the SPIR-V files of the upstream release.

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
		-DLLVM_DIR=/usr/lib/llvm-22/lib/cmake/llvm \
		-DLLVM_SPIRV=/usr/bin/llvm-spirv-22 \
		-DLIBCLC_TARGETS_TO_BUILD="spirv-mesa3d-;spirv64-mesa3d-"

override_dh_auto_test:
