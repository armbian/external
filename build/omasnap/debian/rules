#!/usr/bin/make -f
# Upstream omasnap built with CMake. Install steps follow the upstream Arch
# PKGBUILD (omacom/omarchy-pkgs, pkgbuilds/omasnap).

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release

override_dh_auto_install:
	dh_auto_install
	install -D -m644 README.md debian/omasnap/usr/share/doc/omasnap/README.md

# The smoke suite needs a Wayland session.
override_dh_auto_test:
