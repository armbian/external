#!/usr/bin/make -f
# Repack the vendor Flatpak. Steps follow the upstream Arch PKGBUILD
# (omacom/omarchy-pkgs, pkgbuilds/notion-desktop). The build pulls the
# stable ref: Notion keeps only its newest commit, and it re-exports the
# same version under new commits. ostree checks the commit signature with
# debian/notion.gpg. The commit must be the version in the config: a new
# Notion version fails the build until build/notion-desktop.yaml has it.
include /usr/share/dpkg/pkg-info.mk
include /usr/share/dpkg/architecture.mk

PKG = debian/notion-desktop
REMOTE = https://app.linux-packages.notion.com
APPID = com.notion.app.desktop.notion
OSTREE_ARCH_amd64 = x86_64
OSTREE_ARCH_arm64 = aarch64
REF = app/$(APPID)/$(OSTREE_ARCH_$(DEB_HOST_ARCH))/stable
# 7.45.2+armbian1~forky -> 7.45.2
VERSION = $(firstword $(subst +, ,$(DEB_VERSION_UPSTREAM)))
APP = $(PKG)/opt/notion-desktop

%:
	dh $@

override_dh_auto_build:
	ostree init --repo=debian/repo --mode=bare-user-only
	ostree --repo=debian/repo remote add --gpg-import=debian/notion.gpg notion $(REMOTE)
	ostree --repo=debian/repo pull notion $(REF)
	# The commit body names the Flatpak, for example Notion-arm64-7.45.2.flatpak.
	ostree --repo=debian/repo show notion:$(REF) | grep -qE 'Notion(-arm64)?-$(VERSION)\.flatpak' || \
		{ ostree --repo=debian/repo show notion:$(REF); echo "Notion is not $(VERSION): update the version"; exit 1; }
	ostree --repo=debian/repo checkout --user-mode notion:$(REF) debian/flatpak

# The Electron app is self-contained under files/lib/<app id>. The rest of
# the Flatpak is the sandbox helper and copies of system libraries.
override_dh_auto_install:
	install -d $(APP)
	cp -a debian/flatpak/files/lib/$(APPID)/. $(APP)/
	# The PipeWire binding has a RUNPATH into its build host. Use the system.
	patchelf --remove-rpath \
		$(APP)/resources/app.asar.unpacked/node_modules/node-pipewire/dist/binding/napi-v6/index.node
	install -D -m755 debian/notion-desktop.sh $(PKG)/usr/bin/notion-desktop
	install -D -m644 debian/flatpak/export/share/applications/$(APPID).desktop \
		$(PKG)/usr/share/applications/$(APPID).desktop
	# Outside a Flatpak the window app id is "notion".
	sed -i -e 's|^Exec=.*|Exec=notion-desktop %U|' \
		-e '/^\[Desktop Entry\]/a StartupWMClass=notion' \
		$(PKG)/usr/share/applications/$(APPID).desktop
	for icon in debian/flatpak/export/share/icons/hicolor/*/apps/$(APPID).png; do \
		size=$${icon#debian/flatpak/export/share/icons/hicolor/}; size=$${size%%/*}; \
		install -D -m644 $$icon $(PKG)/usr/share/icons/hicolor/$$size/apps/$(APPID).png || exit 1; \
	done

# Electron needs a setuid sandbox helper on kernels without unprivileged
# user namespaces. dh_fixperms removes the setuid bit.
override_dh_fixperms:
	dh_fixperms
	chmod 4755 $(APP)/chrome-sandbox

override_dh_auto_configure override_dh_auto_test:

# Vendor binaries: keep them as released. Depends lists the libraries by
# hand, after the upstream Arch package.
override_dh_strip override_dh_dwz override_dh_shlibdeps:

override_dh_auto_clean:
	rm -rf debian/repo debian/flatpak
