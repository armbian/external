+# ArmbianRelease.py
+#
+# Armbian: find the next supported release in /etc/armbian-distribution-status.
+# The Armbian build writes one line per release:
+#   <release>=<support>;upgrade=<release>,<release>,...
+# <support> is supported, csc or eos. The rules follow
+# "armbian-config --api release_upgrade stable".
+
+import os
+
+from .utils import get_dist
+
+STATUS_FILE = "/etc/armbian-distribution-status"
+ARMBIAN_CONFIG = "/usr/bin/armbian-config"
+
+
+class ArmbianNextRelease:
+    def __init__(self, codename):
+        self.version = codename
+        self.upgrade_broken = False
+
+
+def read_status(path=STATUS_FILE):
+    """Return {release: (support, [upgrade targets])}, in file order."""
+    status = {}
+    try:
+        with open(path) as f:
+            for line in f:
+                line = line.strip()
+                if "=" not in line:
+                    continue
+                head, _, tail = line.partition(";")
+                release, _, support = head.partition("=")
+                targets = []
+                if tail.startswith("upgrade="):
+                    targets = [
+                        t for t in tail[len("upgrade="):].split(",") if t
+                    ]
+                status[release.strip()] = (support.strip(), targets)
+    except OSError:
+        pass
+    return status
+
+
+def next_release(current, status):
+    """The last supported release in the upgrade list of current."""
+    if current not in status:
+        return None
+    targets = status[current][1]
+    found = None
+    for release, (support, _) in status.items():
+        if release != current and support == "supported" and release in targets:
+            found = release
+    return found
+
+
+class ArmbianRelease:
+    """Answers the questions that UpdateManager asks MetaRelease."""
+
+    def __init__(self, path=STATUS_FILE):
+        self.downloading = False
+        self.flavor_name = "Armbian"
+        self.current_dist_version = get_dist()
+        status = read_status(path)
+        support = status.get(self.current_dist_version, ("", []))[0]
+        target = None
+        if os.path.exists(ARMBIAN_CONFIG):
+            target = next_release(self.current_dist_version, status)
+        self.upgradable_to = ArmbianNextRelease(target) if target else None
+        self.new_dist = self.upgradable_to is not None
+        self.no_longer_supported = support == "eos" and self.new_dist
+
+    def connect(self, *args):
+        # MetaRelease is a GObject. This class never downloads.
+        return 0
