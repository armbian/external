+def run_in_terminal(command):
+    """Armbian: run a root command in a terminal, then wait for Enter."""
+    script = (
+        "sudo %s; echo; read -p '%s' answer"
+        % (command, _("Press Enter to close this window."))
+    )
+    os.execvp(
+        "x-terminal-emulator",
+        ["x-terminal-emulator", "-e", "sh", "-c", script],
+    )
+
