diff -Naur a/debian/rules b/debian/rules
--- a/debian/rules
+++ b/debian/rules
@@ -11,3 +11,12 @@
 	python3 ./tests/test_pycodestyle.py
 	dh_auto_test
 endif
+
+# Armbian: hicolor fallback icon. Numix (Xfce) has no system-software-update.
+override_dh_install:
+	dh_install
+	set -e; for f in debian/armbian/icons/system-software-update-*.png.b64; do \
+		s=$$(basename $$f .png.b64); s=$${s##*-}; \
+		d=debian/update-manager/usr/share/icons/hicolor/$${s}x$${s}/apps; \
+		mkdir -p $$d; base64 -d $$f > $$d/system-software-update.png; \
+	done
