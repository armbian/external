#!/bin/bash

# Armbian: apt repository. Print the menu channel: stable for the stable
# repository, edge for the rolling repository, dev for a source checkout.

set -euo pipefail

if [[ ${OMARCHY_PATH:-/usr/share/omarchy} != "/usr/share/omarchy" ]]; then
  echo dev
  exit 0
fi

case "$(omarchy-version-channel)" in
  stable) echo stable ;;
  rolling) echo edge ;;
  *) echo unknown ;;
esac
