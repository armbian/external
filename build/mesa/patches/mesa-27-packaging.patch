Debian packaging of mesa 26.2 for mesa 27.0 code:
- drop the anti-lag Vulkan layer: 27.0 deleted it, radv implements VK_AMD_anti_lag
- install the new radv files amdgpu_list_devices and 01-radv-performance.conf

--- a/debian/mesa-vulkan-drivers.install
+++ b/debian/mesa-vulkan-drivers.install
@@ -1,3 +1,4 @@
+usr/bin/amdgpu_list_devices
 usr/bin/mesa-overlay-control.py
 usr/bin/mesa-screenshot-control.py
 usr/lib/*/libVkLayer_*.so
@@ -5,3 +6,4 @@
 usr/share/vulkan/explicit_layer.d/*.json
 usr/share/vulkan/icd.d/*.json
 usr/share/vulkan/implicit_layer.d/*.json
+usr/share/drirc.d/01-radv-performance.conf
--- a/debian/rules
+++ b/debian/rules
@@ -148,7 +148,7 @@
 	VULKAN_DEFAULTS += radv lavapipe venus
 	VULKAN_DRIVERS += amd swrast virtio
 
-	VULKAN_LAYERS += anti-lag device-select intel-nullhw overlay screenshot
+	VULKAN_LAYERS += device-select intel-nullhw overlay screenshot
 	confflags_GALLIUM += -Dllvm=enabled
 
 	# Build rusticl for archs where rustc is available
