[Unit]
Description=Armbian first-run wizard
Documentation=https://github.com/armbian/external/tree/main/build/armbian-firstrun-gui
# First boot only. armbian-firstlogin removes the file when the setup is done.
ConditionPathExists=/root/.not_logged_in_yet
After=systemd-udevd.service systemd-user-sessions.service plymouth-quit-wait.service
Before=getty@tty1.service

[Service]
Type=simple
# A screen is necessary. Else tty1 starts and the text setup runs.
ExecCondition=/bin/sh -c 'ls /dev/dri/card* > /dev/null 2>&1 || test -e /dev/fb0'
# getty@tty1 does not start while this file exists (drop-in of this package).
ExecStartPre=/usr/bin/touch /run/armbian-firstrun-gui.active
ExecStart=/usr/bin/armbian-firstrun-gui
# Success: tty1 shows the login. Failure: tty1 starts the text setup.
ExecStopPost=/bin/rm -f /run/armbian-firstrun-gui.active
ExecStopPost=-/bin/systemctl --no-block start getty@tty1.service

[Install]
WantedBy=multi-user.target
