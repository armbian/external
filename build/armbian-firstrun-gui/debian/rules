#!/usr/bin/make -f
# Source: build/armbian-firstrun-gui/ in armbian/external.
# Rust 1.85 or newer. Ubuntu noble has it in /usr/lib/rust-1.85/bin (rustc-1.85,
# cargo-1.85). Build scripts call "rustc": put that directory first in PATH.
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/target
export PATH := $(if $(wildcard /usr/lib/rust-1.85/bin),/usr/lib/rust-1.85/bin:)$(PATH)
PKG = debian/armbian-firstrun-gui
SLINT_BACKEND = target/i-slint-backend-linuxkms

%:
	dh $@

override_dh_auto_configure:
	# Patch a private copy. Keep the shared Cargo registry unchanged.
	mkdir -p target
	curl --fail --location --retry 3 --output $(SLINT_BACKEND).crate \
		https://static.crates.io/crates/i-slint-backend-linuxkms/i-slint-backend-linuxkms-1.13.1.crate
	echo 'efe95e5c81a08027a03535d69aa025740275b11fb613abf555441ce074001119  $(SLINT_BACKEND).crate' | sha256sum --check
	rm -rf $(SLINT_BACKEND)
	mkdir -p $(SLINT_BACKEND)
	tar -xzf $(SLINT_BACKEND).crate --strip-components=1 -C $(SLINT_BACKEND)
	patch --batch --forward --fuzz=0 -p1 -d $(SLINT_BACKEND) < debian/slint-linuxkms-row-pitch.patch

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_install:
	install -D -m755 target/release/armbian-firstrun-gui $(PKG)/usr/bin/armbian-firstrun-gui
	install -D -m644 debian/firstrun-gui.conf $(PKG)/etc/armbian/firstrun-gui.conf
	install -D -m644 debian/getty-tty1.conf $(PKG)/usr/lib/systemd/system/getty@tty1.service.d/armbian-firstrun-gui.conf

# The wizard starts at boot only. It does nothing on a configured system.
# An upgrade must not stop a wizard that runs on the screen.
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade

override_dh_auto_test:

override_dh_auto_clean:
	rm -rf target debian/cargo-home
