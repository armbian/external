// Armbian first-run wizard. Logic: src/main.rs.
// Widgets are drawn here: the look does not come from a Slint style.
// Sizes use "px", one unit that grows on large screens.
import { ListView } from "std-widgets.slint";
import { VirtualKeyboard } from "virtual-keyboard.slint";

// Colors of the armbian.com dark theme. All tints come from the accent,
// so that ACCENT in the configuration changes them together.
export global Theme {
    in property <color> accent: #f26522;
    // Fill below white text: the accent alone has too little contrast.
    out property <color> accent-solid: accent.darker(0.2);
    out property <color> accent-hover: accent.darker(0.1);
    // Opaque tints. Blending on large areas is slow in the software renderer.
    out property <color> accent-soft: accent.mix(bg, 0.16);
    out property <color> accent-line: accent.mix(bg, 0.5);
    // Dark greys keep red, green and blue equal on a 16-bit panel: no green tint.
    out property <color> bg: #0c0c0c;
    out property <color> field: #1b1b1b;
    out property <color> surface: #202020;
    out property <color> border: #2a2a2a;
    // Edge of a control: 3:1 on the background.
    out property <color> edge: #5c5c5c;
    out property <color> text: #f0f0f0;
    out property <color> dim: #a1a1a1;
    out property <color> faint: #828282;
    out property <color> success: #22a65a;
    out property <color> error: #e36d6e;
    out property <color> warning: #f59e0b;
}

export global InputCapabilities {
    in-out property <bool> has-touchscreen;
}

export struct WifiNet {
    ssid: string,
    signal: int,
    secure: bool,
}

component Icon inherits Image {
    in property <length> size: 16px;
    width: self.size;
    height: self.size;
    image-fit: contain;
}

// A pill button. Tab reaches it. Enter or Space presses it.
component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> small;
    // Full width of its row.
    in property <bool> wide;
    in property <length> px: 1px;
    callback clicked;
    // Asks the page to scroll this control into view: its window position and height.
    callback reveal(length, length);
    changed has-keyboard-focus => {
        if self.has-keyboard-focus {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    out property <bool> has-keyboard-focus: focus.has-focus;
    horizontal-stretch: root.wide ? 1 : 0;
    vertical-stretch: 0;
    height: (root.small ? 38 : 48) * root.px;
    min-width: max((root.primary ? 148 : 0) * root.px, label.preferred-width + (root.small ? 36 : 52) * root.px);
    border-radius: 10 * root.px;
    background: root.primary ? (!root.enabled ? Theme.field : ta.pressed || ta.has-hover ? Theme.accent-hover : Theme.accent-solid) : (ta.pressed ? Theme.border : ta.has-hover ? Theme.field : transparent);
    border-width: root.primary ? 0px : 1px;
    border-color: root.enabled ? Theme.edge : Theme.border;
    animate background { duration: 150ms; }
    // Focus ring outside the button.
    Rectangle {
        visible: focus.has-focus;
        x: -4 * root.px;
        y: -4 * root.px;
        width: parent.width + 8 * root.px;
        height: parent.height + 8 * root.px;
        border-radius: 14 * root.px;
        border-width: 2 * root.px;
        border-color: Theme.accent;
    }

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.faint : root.primary ? white : Theme.text;
        font-size: (root.small ? 14 : root.wide ? 18 : 16) * root.px;
        font-weight: 600;
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            focus.focus();
            root.clicked();
        }
    }
}

// A text field with an optional label above it.
component Field inherits VerticalLayout {
    in property <string> label;
    // > 0: the label is left of the box, this wide.
    in property <length> label-width;
    // Quiet text under the box, and an error that replaces it.
    in property <string> help;
    in property <string> error-text;
    out property <bool> focused: ti.has-focus;
    // The space above the on-screen keyboard. A change shows the field again.
    in property <length> watch;
    // Asks the page to scroll this field into view: its window position and height.
    callback reveal(length, length);
    // Quiet text after the label: where the value comes from.
    in property <string> note;
    in property <bool> enabled: true;
    in-out property <string> text <=> ti.text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> search;
    in property <bool> invalid;
    in property <bool> dense;
    in property <length> px: 1px;
    callback edited(string);
    callback accepted();
    property <bool> shown;
    property <length> margin: 2 * root.px;
    changed focused => {
        if self.focused {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    changed watch => {
        if self.focused {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    forward-focus: ti;
    // Fields in one row get the same width.
    preferred-width: 120 * root.px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    spacing: (root.dense ? 5 : 8) * root.px;
    if root.label != "" && root.label-width == 0: HorizontalLayout {
        spacing: 6 * root.px;
        Text {
            horizontal-stretch: 0;
            text: root.label;
            color: Theme.dim;
            font-size: (root.dense ? 13 : 14) * root.px;
            font-weight: 600;
        }

        Text {
            horizontal-stretch: 1;
            text: root.note != "" ? "· " + root.note : "";
            color: Theme.faint;
            font-size: (root.dense ? 13 : 14) * root.px;
            overflow: elide;
        }
    }
    HorizontalLayout {
    spacing: 16 * root.px;
    if root.label-width > 0: Text {
        width: root.label-width;
        text: root.label;
        color: Theme.text;
        font-size: 16 * root.px;
        vertical-alignment: center;
        overflow: elide;
    }
    box := Rectangle {
        horizontal-stretch: 1;
        height: (root.dense ? 44 : 48) * root.px;
        border-radius: 10 * root.px;
        background: Theme.field;
        border-width: ti.has-focus || root.invalid ? 2px : 1px;
        border-color: root.invalid ? Theme.error : ti.has-focus ? Theme.accent : root.enabled ? Theme.edge : Theme.border;
        // Focus ring: a small area, so blending is cheap.
        Rectangle {
            visible: ti.has-focus;
            x: -3 * root.px;
            y: -3 * root.px;
            width: parent.width + 6 * root.px;
            height: parent.height + 6 * root.px;
            border-radius: 13 * root.px;
            border-width: 3 * root.px;
            border-color: Theme.accent.with-alpha(0.22);
        }

        HorizontalLayout {
            padding-left: 16 * root.px;
            padding-right: (root.password ? 4 : 16) * root.px;
            spacing: 8 * root.px;
            if root.search: VerticalLayout {
                alignment: center;
                Icon {
                    source: @image-url("icons/search.svg");
                    colorize: Theme.faint;
                    size: 16 * root.px;
                }
            }
            clip := Rectangle {
                horizontal-stretch: 1;
                clip: true;
                Text {
                    visible: ti.text == "";
                    x: 0px;
                    width: parent.width;
                    text: root.placeholder;
                    color: Theme.faint;
                    font-size: 16 * root.px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // The text scrolls to keep the cursor in view.
                ti := TextInput {
                    property <length> shift;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.shift));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    single-line: true;
                    enabled: root.enabled;
                    vertical-alignment: center;
                    color: root.enabled ? Theme.text : Theme.faint;
                    font-size: 16 * root.px;
                    input-type: root.password && !root.shown ? InputType.password : InputType.text;
                    selection-background-color: Theme.accent-solid;
                    selection-foreground-color: white;
                    edited => {
                        root.edited(self.text);
                    }
                    accepted => {
                        root.accepted();
                    }
                    cursor-position-changed(pos) => {
                        if pos.x + self.shift < root.margin {
                            self.shift = -pos.x + root.margin;
                        } else if pos.x + self.shift > parent.width - root.margin - self.text-cursor-width {
                            self.shift = parent.width - pos.x - root.margin - self.text-cursor-width;
                        }
                    }
                }
                // Reopen a dismissed keyboard without changing the text selection.
                TouchArea {
                    enabled: InputCapabilities.has-touchscreen && ti.has-focus && !TextInputInterface.text-input-focused;
                    clicked => { TextInputInterface.text-input-focused = true; }
                }
            }

            // Show or hide the password.
            if root.password: Rectangle {
                width: 44 * root.px;
                Icon {
                    source: root.shown ? @image-url("icons/eye-off.svg") : @image-url("icons/eye.svg");
                    colorize: eye.has-hover ? Theme.text : Theme.faint;
                    size: 18 * root.px;
                }

                eye := TouchArea {
                    clicked => {
                        root.shown = !root.shown;
                    }
                }
            }
        }
    }
    }
    if root.help != "" || root.error-text != "": HorizontalLayout {
        spacing: 16 * root.px;
        if root.label-width > 0: Rectangle {
            width: root.label-width;
        }
        Text {
            horizontal-stretch: 1;
            text: root.error-text != "" ? root.error-text : root.help;
            color: root.error-text != "" ? Theme.error : Theme.dim;
            font-size: 14 * root.px;
            wrap: word-wrap;
        }
    }
}

// Two or more choices, all in view. Left and Right change the choice.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <string> value;
    in property <length> px: 1px;
    function step(d: int) {
        if root.options.length == 0 {
            return;
        }
        root.value = root.options[max(0, min(root.options.length - 1, root.index() + d))];
    }
    pure function index() -> int {
        return root.options[0] == root.value ? 0 : 1;
    }
    width: root.options.length * 96 * root.px;
    height: 42 * root.px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: Theme.field;
    border-width: 1px;
    border-color: fs.has-focus ? Theme.accent : Theme.edge;
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.LeftArrow {
                root.step(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.step(1);
                return accept;
            }
            if event.text == " " {
                root.value = root.options[root.index() == 0 ? 1 : 0];
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding: 3 * root.px;
        for option in root.options: Rectangle {
            border-radius: self.height / 2;
            background: option == root.value ? Theme.accent-soft : transparent;
            border-width: option == root.value ? 1px : 0px;
            border-color: Theme.accent-line;
            Text {
                text: option;
                color: option == root.value ? Theme.text : Theme.dim;
                font-size: 15 * root.px;
                font-weight: 600;
            }

            TouchArea {
                clicked => {
                    fs.focus();
                    root.value = option;
                }
            }
        }
    }
}

// A thin progress line. Indeterminate: a part moves along the line.
component Bar inherits Rectangle {
    in property <float> progress;
    in property <bool> indeterminate;
    in property <color> tint: Theme.accent;
    in property <length> px: 1px;
    height: 4 * root.px;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    background: Theme.border;
    clip: true;
    Rectangle {
        property <float> t: mod(animation-tick(), 1.6s) / 1.6s;
        x: root.indeterminate ? (self.t * 1.3 - 0.3) * parent.width : 0px;
        width: root.indeterminate ? parent.width * 0.3 : parent.width * max(0, min(1, root.progress));
        height: 100%;
        border-radius: self.height / 2;
        background: root.tint;
        animate width {
            duration: 400ms;
            easing: ease-out;
        }
    }
}

// Signal strength as 4 bars.
component Bars inherits HorizontalLayout {
    in property <int> signal;
    in property <length> px: 1px;
    spacing: 2 * root.px;
    for i in 4: VerticalLayout {
        alignment: end;
        Rectangle {
            width: 4 * root.px;
            height: (5 + i * 3) * root.px;
            border-radius: 1 * root.px;
            background: root.signal > i * 25 ? Theme.text : Theme.edge;
        }
    }
}

// A message with an optional mark: an error, or a note.
component Note inherits HorizontalLayout {
    in property <string> text;
    in property <bool> error;
    in property <color> dot: transparent;
    in property <length> px: 1px;
    spacing: 8 * root.px;
    alignment: start;
    if root.error && root.text != "": VerticalLayout {
        alignment: center;
        Icon {
            source: @image-url("icons/alert.svg");
            colorize: Theme.error;
            size: 18 * root.px;
        }
    }
    if !root.error && root.text != "" && root.dot.alpha > 0: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 8 * root.px;
            height: 8 * root.px;
            border-radius: 4 * root.px;
            background: root.dot;
        }
    }
    Text {
        horizontal-stretch: 1;
        text: root.text;
        color: root.error ? Theme.error : Theme.dim;
        font-size: 15 * root.px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

// One of the three region values. A press shows its list.
component RegionTab inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> active;
    in property <bool> focused;
    in property <bool> dense;
    in property <length> px: 1px;
    callback clicked;
    height: (root.dense ? 54 : 72) * root.px;
    border-radius: 14 * root.px;
    background: root.active ? Theme.accent-soft : ta.has-hover ? Theme.field : transparent;
    border-width: root.active && root.focused ? 2px : 1px;
    border-color: !root.active ? Theme.border : root.focused ? Theme.accent : Theme.accent-line;
    animate background { duration: 150ms; }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding-left: 18 * root.px;
        padding-right: 18 * root.px;
        spacing: 4 * root.px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.dim;
            font-size: (root.dense ? 13 : 14) * root.px;
            overflow: elide;
        }

        Text {
            text: root.value;
            color: Theme.text;
            font-size: (root.dense ? 15 : 17) * root.px;
            font-weight: 600;
            overflow: elide;
        }
    }
}

// A list with a search field. Up and Down change the value.
component PickList inherits VerticalLayout {
    in property <string> placeholder;
    in property <[StandardListViewItem]> model;
    // Set by Rust. The list scrolls to it.
    in property <int> current: -1;
    in property <bool> dense;
    in property <length> px: 1px;
    // The list gets the focus after the first layout.
    in property <bool> start-focus;
    callback search(string);
    callback picked(int);
    property <length> row-h: (root.dense ? 40 : 48) * root.px;
    property <bool> layout-ready;
    property <length> available-height: root.layout-ready ? list.visible-height : 0px;
    spacing: (root.dense ? 8 : 12) * root.px;
    // Put the value in the middle of the list.
    function scroll() {
        if root.current < 0 || root.model.length == 0 {
            return;
        }
        // Whole rows at the top: no row is cut there.
        let rows-before = max(0, floor((list.visible-height / root.row-h - 1) / 2));
        list.viewport-y = -max(0px, min(root.model.length * root.row-h - list.visible-height, root.row-h * max(0, root.current - rows-before)));
    }
    function pick(i: int) {
        if root.model.length == 0 {
            return;
        }
        root.picked(max(0, min(root.model.length - 1, i)));
    }
    changed current => {
        scroll();
    }
    // Keep the selection in view when the keyboard changes the list height.
    changed available-height => { scroll(); }
    Field {
        px: root.px;
        dense: root.dense;
        search: true;
        placeholder: root.placeholder;
        edited(t) => {
            root.search(t);
        }
    }

    Rectangle {
        vertical-stretch: 1;
        // The keyboard can leave less than two rows. Scroll within that space.
        min-height: 0px;
        border-radius: 12 * root.px;
        border-width: keys.has-focus ? 2px : 1px;
        border-color: keys.has-focus ? Theme.accent : Theme.border;
        keys := FocusScope {
            focus-on-click: false;
            Timer {
                interval: 1ms;
                running: root.start-focus;
                triggered => {
                    self.running = false;
                    keys.focus();
                }
            }
            key-pressed(event) => {
                if event.text == Key.UpArrow {
                    root.pick(root.current - 1);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.pick(root.current + 1);
                    return accept;
                }
                if event.text == Key.Home {
                    root.pick(0);
                    return accept;
                }
                if event.text == Key.End {
                    root.pick(root.model.length - 1);
                    return accept;
                }
                return reject;
            }
        }

        list := ListView {
            x: 4 * root.px;
            y: 4 * root.px;
            width: parent.width - 8 * root.px;
            height: max(0px, parent.height - 8 * root.px);
            for item[i] in root.model: Rectangle {
                height: root.row-h;
                Rectangle {
                    y: 1 * root.px;
                    height: parent.height - 2 * root.px;
                    border-radius: 9 * root.px;
                    background: i == root.current ? Theme.accent-soft : ta.has-hover ? Theme.field : transparent;
                    HorizontalLayout {
                        padding-left: 12 * root.px;
                        padding-right: 12 * root.px;
                        spacing: 8 * root.px;
                        Text {
                            horizontal-stretch: 1;
                            text: item.text;
                            color: Theme.text;
                            font-size: 16 * root.px;
                            font-weight: i == root.current ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        if i == root.current: VerticalLayout {
                            alignment: center;
                            Icon {
                                source: @image-url("icons/check.svg");
                                colorize: Theme.accent;
                                size: 16 * root.px;
                            }
                        }
                    }
                }

                ta := TouchArea {
                    clicked => {
                        keys.focus();
                        if i != root.current {
                            root.picked(i);
                        }
                    }
                }
            }
        }
    }

    // After the first layout: scroll to the value.
    Timer {
        interval: 250ms;
        running: true;
        triggered => {
            self.running = false;
            root.layout-ready = true;
        }
    }
}

// The logo, or the TITLE text of the configuration.
component Brand inherits HorizontalLayout {
    in property <image> logo;
    in property <string> product;
    // Height of the logo, and font size of the text.
    in property <length> size: 26px;
    // The logo or the text is not wider than this: a wide one becomes smaller.
    in property <length> limit: 10000px;
    alignment: start;
    if root.product == "": Image {
        source: root.logo;
        height: min(root.size, root.limit * self.source.height / max(1, self.source.width));
        width: self.height * self.source.width / max(1, self.source.height);
        image-fit: contain;
    }
    if root.product != "": Rectangle {
        property <float> fit: min(1, root.limit / max(1px, probe.preferred-width));
        width: shown.preferred-width;
        height: root.size;
        // Not in view: it gives the width of the text at the full size.
        probe := Text {
            visible: false;
            text: root.product;
            font-size: root.size;
            font-weight: 700;
        }

        shown := Text {
            text: root.product;
            color: Theme.text;
            font-size: root.size * parent.fit;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// A title in the middle, with an optional line under it.
component Heading inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> small;
    in property <length> px: 1px;
    spacing: 8 * root.px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: (root.small ? 24 : 32) * root.px;
        font-weight: 700;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.subtitle != "": Text {
        text: root.subtitle;
        color: Theme.dim;
        font-size: (root.small ? 15 : 17) * root.px;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// The logo in the middle of its row.
component Logo inherits HorizontalLayout {
    in property <image> logo;
    in property <string> product;
    in property <length> size;
    in property <length> limit;
    alignment: center;
    Brand {
        logo: root.logo;
        product: root.product;
        size: root.size;
        limit: root.limit;
    }
}

// The network state in one quiet line: a dot, the state, the address.
component NetStatus inherits Rectangle {
    in property <string> ip;
    in property <length> px: 1px;
    width: min(row.preferred-width, 10000px);
    height: 36 * root.px;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    row := HorizontalLayout {
        padding-left: 14 * root.px;
        padding-right: 16 * root.px;
        spacing: 10 * root.px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8 * root.px;
                height: 8 * root.px;
                border-radius: 4 * root.px;
                background: root.ip != "" ? Theme.success : Theme.faint;
            }
        }

        Text {
            text: root.ip != "" ? "Connected" : "Not connected";
            color: Theme.text;
            font-size: 14 * root.px;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.ip != "": Text {
            text: root.ip;
            color: Theme.dim;
            font-size: 14 * root.px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// The result of the git account lookup.
component GitCard inherits Rectangle {
    // The profile picture, round, made by Rust. Without one: a mark.
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <string> title;
    in property <string> detail;
    in property <bool> found;
    in property <bool> warn;
    in property <bool> checking;
    in property <length> px: 1px;
    border-radius: 10 * root.px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding: 12 * root.px;
        padding-left: 14 * root.px;
        spacing: 12 * root.px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            if root.has-avatar && root.found: Rectangle {
                width: 44 * root.px;
                height: 44 * root.px;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.avatar;
                    image-fit: contain;
                }

                // A small check on the picture.
                Rectangle {
                    x: parent.width - 16 * root.px;
                    y: parent.height - 16 * root.px;
                    width: 18 * root.px;
                    height: 18 * root.px;
                    border-radius: 9 * root.px;
                    background: Theme.success;
                    border-width: 2 * root.px;
                    border-color: Theme.surface;
                    Icon {
                        source: @image-url("icons/check.svg");
                        colorize: white;
                        size: 11 * root.px;
                    }
                }
            }
            if !(root.has-avatar && root.found): Rectangle {
                width: 28 * root.px;
                height: 28 * root.px;
                border-radius: 14 * root.px;
                background: root.found ? Theme.success : root.warn ? Theme.warning : Theme.field;
                if root.found: Icon {
                    source: @image-url("icons/check.svg");
                    colorize: white;
                    size: 16 * root.px;
                }
                if root.warn: Icon {
                    source: @image-url("icons/alert.svg");
                    colorize: Theme.bg;
                    size: 16 * root.px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4 * root.px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 15 * root.px;
                font-weight: 600;
                overflow: elide;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: Theme.dim;
                font-size: 14 * root.px;
                overflow: elide;
            }
            if root.checking: Bar {
                px: root.px;
                indeterminate: true;
            }
        }
    }
}

// A check box with a label and a quiet second line. Space or a press changes it.
component CheckRow inherits Rectangle {
    callback reveal(length, length);
    out property <bool> has-keyboard-focus: fs.has-focus;
    changed has-keyboard-focus => {
        if self.has-keyboard-focus {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    in property <string> text;
    in property <string> detail;
    in-out property <bool> checked;
    in property <length> px: 1px;
    min-height: 48 * root.px;
    border-radius: 8 * root.px;
    background: ta.has-hover ? Theme.field : transparent;
    HorizontalLayout {
        padding-left: 8 * root.px;
        padding-right: 8 * root.px;
        spacing: 12 * root.px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 24 * root.px;
                height: 24 * root.px;
                border-radius: 6 * root.px;
                background: root.checked ? Theme.accent-solid : Theme.field;
                border-width: fs.has-focus ? 2px : 1px;
                border-color: fs.has-focus ? Theme.accent : root.checked ? Theme.accent-solid : Theme.edge;
                if root.checked: Icon {
                    source: @image-url("icons/check.svg");
                    colorize: white;
                    size: 16 * root.px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2 * root.px;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: 15 * root.px;
                overflow: elide;
            }

            if root.detail != "": Text {
                text: root.detail;
                color: Theme.dim;
                font-size: 13 * root.px;
                overflow: elide;
            }
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == " " {
                root.checked = !root.checked;
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        clicked => {
            fs.focus();
            root.checked = !root.checked;
        }
    }
}

// A setting with its value. A press opens its list.
component SettingRow inherits Rectangle {
    callback reveal(length, length);
    out property <bool> has-keyboard-focus: fs.has-focus;
    changed has-keyboard-focus => {
        if self.has-keyboard-focus {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    in property <string> label;
    in property <string> value;
    in property <length> px: 1px;
    callback clicked;
    height: 48 * root.px;
    border-radius: 8 * root.px;
    background: ta.has-hover || fs.has-focus ? Theme.field : transparent;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: 8 * root.px;
        padding-right: 12 * root.px;
        spacing: 12 * root.px;
        Text {
            horizontal-stretch: 0;
            text: root.label;
            color: Theme.dim;
            font-size: 15 * root.px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text;
            font-size: 15 * root.px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            horizontal-stretch: 0;
            text: "›";
            color: Theme.dim;
            font-size: 20 * root.px;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
}

// A row that opens or closes the section under it.
component Disclosure inherits Rectangle {
    callback reveal(length, length);
    out property <bool> has-keyboard-focus: fs.has-focus;
    changed has-keyboard-focus => {
        if self.has-keyboard-focus {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    in property <string> text;
    in property <string> summary;
    in-out property <bool> open;
    in property <length> px: 1px;
    height: 48 * root.px;
    border-radius: 8 * root.px;
    background: ta.has-hover || fs.has-focus ? Theme.field : transparent;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    HorizontalLayout {
        padding-left: 8 * root.px;
        padding-right: 12 * root.px;
        spacing: 10 * root.px;
        Text {
            horizontal-stretch: 0;
            width: 16 * root.px;
            text: root.open ? "▾" : "▸";
            color: Theme.dim;
            font-size: 16 * root.px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 0;
            text: root.text;
            color: Theme.text;
            font-size: 16 * root.px;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            text: root.open ? "" : root.summary;
            color: Theme.dim;
            font-size: 14 * root.px;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.open = !root.open;
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        clicked => {
            fs.focus();
            root.open = !root.open;
        }
    }
}

// A quiet text button.
component LinkButton inherits Rectangle {
    callback reveal(length, length);
    out property <bool> has-keyboard-focus: fs.has-focus;
    changed has-keyboard-focus => {
        if self.has-keyboard-focus {
            root.reveal(self.absolute-position.y, self.height);
        }
    }
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> px: 1px;
    callback clicked;
    height: 44 * root.px;
    min-width: label.preferred-width + 24 * root.px;
    horizontal-stretch: 0;
    border-radius: 8 * root.px;
    background: fs.has-focus ? Theme.field : transparent;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: Theme.accent;
    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.faint : ta.has-hover ? Theme.text : Theme.dim;
        font-size: 16 * root.px;
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "Armbian setup";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-size: 16px;
    in property <string> font-family;
    default-font-family: font-family;

    in property <image> logo: @image-url("armbian-logo.svg");
    in property <image> background-image;
    in property <bool> has-background;
    // Empty: the logo.
    in property <string> product;
    in property <bool> dry-run;

    // 0 network check, 1 Wi-Fi, 2 quick setup, 3 region, 4 apply.
    in-out property <int> page: 0;
    in property <string> status;

    in property <[WifiNet]> wifi-model;
    in-out property <int> wifi-current: -1;
    in-out property <string> wifi-password;
    in property <bool> wifi-busy;
    in property <string> wifi-status;

    in property <[StandardListViewItem]> tz-model;
    in property <int> tz-current: -1;
    in property <string> timezone;
    in property <[StandardListViewItem]> locale-model;
    in property <int> locale-current: -1;
    in property <string> locale;
    in property <[StandardListViewItem]> kb-model;
    in property <int> kb-current: -1;
    in property <string> keyboard;

    // The first field: a local username, or "@user" for a git account.
    in-out property <string> account;
    in-out property <string> realname;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> password2;
    in property <bool> has-zsh;
    in-out property <string> shell: "bash";
    // IPv4 addresses, for SSH. Empty without a network.
    in property <string> ip-address;
    // Rust: the form is complete and no lookup runs.
    in property <bool> can-apply;
    // An error of the username, under the first field.
    in property <string> account-error;

    // Git account lookup: a title and a detail line.
    in property <string> git-title;
    in property <string> git-detail;
    in property <image> git-avatar;
    in property <bool> git-has-avatar;
    in property <bool> git-found;
    in property <bool> git-warn;
    in property <bool> git-checking;
    // The values that came from the account, and its name for the labels.
    in property <string> git-name;
    in property <string> git-username;
    in property <string> git-source;
    // What the account brings. The user can turn each off.
    in property <int> git-keys;
    in property <string> git-keys-url;
    in property <string> git-dotfiles-url;
    in-out property <bool> import-keys: true;
    in-out property <bool> import-dotfiles: true;
    // Rust adds 1 after it fills the fields from a git account: the password gets the focus.
    in property <int> git-filled;
    // Page 3 with the keyboard list only, opened from the Wi-Fi page.
    in property <bool> keyboard-only;

    in property <string> error;
    in property <string> log;
    // Setup progress, 0 to 1.
    in property <float> progress;
    in property <bool> busy;
    in property <bool> failed;
    in property <bool> finished;

    callback wifi-rescan();
    callback wifi-connect();
    callback wifi-skip();
    callback search-tz(string);
    callback pick-tz(int);
    callback search-locale(string);
    callback pick-locale(int);
    callback search-kb(string);
    callback pick-kb(int);
    callback account-edited(string);
    callback realname-edited(string);
    callback username-edited(string);
    callback git-changed();
    callback change-region();
    callback change-keyboard();
    callback region-done();
    callback region-cancel();
    callback apply();
    callback finish();
    callback text-mode();
    callback key-down(string);
    callback key-up(string);
    callback screen-key(string);
    in-out property <bool> screen-key-active;
    property <bool> screen-keyboard-visible: InputCapabilities.has-touchscreen && TextInputInterface.text-input-focused && root.page >= 1 && root.page <= 3 && !root.wifi-busy;
    property <length> screen-keyboard-height: min(280 * root.px, root.height * 0.4);
    property <length> content-height: root.height - (root.screen-keyboard-visible ? root.screen-keyboard-height : 0px);
    // With the on-screen keyboard open, decorations hide and the content scrolls.
    property <bool> typing: root.screen-keyboard-visible;

    // Layout. Large screens: all sizes grow, to 2 times at most.
    property <float> scale: max(1, min(2, min(self.width / 1280px, self.height / 800px)));
    property <length> px: 1px * self.scale;
    property <bool> compact: self.width < 940px;
    property <bool> dense: self.content-height < 560px;
    property <length> side: self.compact ? 16px : 32 * self.px;
    // One column for all pages. The region lists use a little more width.
    property <length> col-w: min(self.width - 2 * self.side, (self.page == 3 ? 720 : 600) * self.px);
    property <length> vpad: self.typing ? 8 * self.px : self.dense ? 16 * self.px : 40 * self.px;
    property <length> gap: (self.typing ? 10 : self.dense ? 14 : 20) * self.px;
    // Password labels go left of the box when the column is wide enough.
    property <length> inline-w: self.col-w >= 520 * self.px ? 170 * self.px : 0px;
    property <length> logo-size: (self.dense ? 30 : 40) * self.px;
    property <bool> with-log: self.page == 4 && (self.failed || self.dry-run);
    property <string> apply-title: self.failed ? "Setup failed" : self.dry-run ? "Dry run complete" : "Applying settings…";
    property <string> apply-status: self.failed ? "The text setup asks the same questions on this screen." : self.dry-run ? "Press Enter to close." : "";
    // Which region list shows: 0 time zone, 1 language, 2 keyboard. Set before change-region().
    in-out property <int> region-tab: 0;
    property <bool> customize-open;
    property <string> summary: (root.shell == "zsh" ? "Zsh" : "Bash") + " · " + root.locale + " · " + root.timezone + " · " + root.keyboard;

    // Scroll the content so that a field at this window position is in view.
    function reveal(y: length, h: length) {
        let at = y - flick.absolute-position.y - flick.viewport-y;
        let first = at - 8 * root.px;
        let last = at + h + 8 * root.px;
        let lowest = -max(0px, flick.viewport-height - flick.height);
        if first < -flick.viewport-y {
            flick.viewport-y = max(lowest, min(0px, -first));
        } else if last > -flick.viewport-y + flick.height {
            flick.viewport-y = max(lowest, min(0px, -(last - flick.height)));
        }
    }

    // A configured background image. Else the plain dark background.
    if root.has-background: Image {
        width: 100%;
        height: 100%;
        source: root.background-image;
        image-fit: cover;
    }
    // Key repeat on KMS: libinput sends one press only. Rust repeats a held key.
    keys := FocusScope {
        // Blank areas must not take focus from the text input.
        focus-on-click: false;
        capture-key-pressed(event) => {
            root.key-down(event.text);
            return reject;
        }
        capture-key-released(event) => {
            // Physical typing keeps the full form visible.
            if !root.screen-key-active {
                TextInputInterface.text-input-focused = false;
            }
            root.key-up(event.text);
            return reject;
        }

        // The content scrolls when it is higher than the screen. Shorter content stays in the middle.
        flick := Flickable {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.content-height;
            viewport-width: self.width;
            viewport-height: max(self.height, col.preferred-height);
            col := VerticalLayout {
                x: (flick.width - root.col-w) / 2;
                width: root.col-w;
                height: flick.viewport-height;
                padding-top: root.vpad;
                padding-bottom: root.vpad;
                alignment: root.page == 3 || root.with-log ? stretch : center;

                // 0: network check. 4: setup. Only the logo, one line and the progress.
                if root.page == 0 || (root.page == 4 && !root.with-log): VerticalLayout {
                    spacing: (root.dense ? 28 : 40) * root.px;
                    Timer {
                        interval: 1ms;
                        running: root.page == 4;
                        triggered => {
                            self.running = false;
                            keys.focus();
                        }
                    }
                    Logo {
                        logo: root.logo;
                        product: root.product;
                        size: (root.dense ? 36 : 48) * root.px;
                        limit: root.col-w;
                    }

                    Heading {
                        px: root.px;
                        small: true;
                        title: root.page == 0 ? root.status : root.apply-title;
                        subtitle: root.page == 4 ? root.apply-status : "";
                    }

                    HorizontalLayout {
                        alignment: center;
                        Bar {
                            width: min(root.col-w, 320 * root.px);
                            px: root.px;
                            height: 4 * root.px;
                            indeterminate: root.page == 0;
                            progress: root.progress;
                        }
                    }
                }

                // 1: Wi-Fi. Keys: Up/Down select, Enter password or connect, Escape skip.
                if root.page == 1: wifi := FocusScope {
                    focus-on-click: false;
                    property <length> row-h: (root.dense ? 48 : 52) * root.px;
                    property <int> rows-shown: root.wifi-model.length == 0 ? 3 : min(root.typing ? 3 : 5, root.wifi-model.length);
                    function select(i: int) {
                        if root.wifi-model.length == 0 {
                            return;
                        }
                        root.wifi-current = max(0, min(root.wifi-model.length - 1, i));
                        root.wifi-password = "";
                        scroll();
                    }
                    function scroll() {
                        if root.wifi-current < 0 {
                            return;
                        }
                        if root.wifi-current * wifi.row-h < -nets.viewport-y {
                            nets.viewport-y = -root.wifi-current * wifi.row-h;
                        }
                        if (root.wifi-current + 1) * wifi.row-h > -nets.viewport-y + nets.visible-height {
                            nets.viewport-y = -((root.wifi-current + 1) * wifi.row-h - nets.visible-height);
                        }
                    }
                    function needs-password() -> bool {
                        return root.wifi-current >= 0 && root.wifi-model[root.wifi-current].secure;
                    }
                    // The on-screen keyboard makes the list shorter: keep the selected network in view.
                    changed rows-shown => {
                        scroll-later.running = true;
                    }
                    scroll-later := Timer {
                        interval: 1ms;
                        running: false;
                        triggered => {
                            self.running = false;
                            wifi.scroll();
                        }
                    }
                    capture-key-pressed(event) => {
                        if root.wifi-busy {
                            return reject;
                        }
                        if event.text == Key.UpArrow {
                            select(root.wifi-current - 1);
                            return accept;
                        }
                        if event.text == Key.DownArrow {
                            select(root.wifi-current + 1);
                            return accept;
                        }
                        if event.text == Key.Escape {
                            root.wifi-skip();
                            return accept;
                        }
                        if event.text == Key.Return {
                            // A focused button takes Enter itself.
                            if change-button.has-keyboard-focus || scan-button.has-keyboard-focus || skip-button.has-keyboard-focus {
                                return reject;
                            }
                            if needs-password() && root.wifi-password == "" {
                                password.focus();
                            } else if root.wifi-current >= 0 {
                                root.wifi-connect();
                            }
                            return accept;
                        }
                        return reject;
                    }
                    Timer {
                        interval: 1ms;
                        running: true;
                        triggered => {
                            self.running = false;
                            wifi.focus();
                        }
                    }

                    VerticalLayout {
                        spacing: root.gap;
                        if !root.typing: VerticalLayout {
                            spacing: (root.dense ? 12 : 20) * root.px;
                            Logo {
                                logo: root.logo;
                                product: root.product;
                                size: root.logo-size;
                                limit: root.col-w;
                            }

                            Heading {
                                px: root.px;
                                small: root.dense;
                                title: "Connect to Wi-Fi";
                                subtitle: root.dense ? "" : "Choose a network and enter the password.";
                            }
                        }

                        // The keyboard comes before the password. Not in the key scope: Enter presses the buttons.
                        HorizontalLayout {
                            spacing: 12 * root.px;
                            Text {
                                horizontal-stretch: 0;
                                text: "Keyboard";
                                color: Theme.dim;
                                font-size: 15 * root.px;
                                vertical-alignment: center;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.keyboard;
                                color: Theme.text;
                                font-size: 15 * root.px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            change-button := PillButton {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                small: true;
                                text: "Change";
                                enabled: !root.wifi-busy;
                                clicked => {
                                    root.change-keyboard();
                                }
                            }

                            scan-button := PillButton {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                small: true;
                                text: "Scan";
                                enabled: !root.wifi-busy;
                                clicked => {
                                    root.wifi-rescan();
                                }
                            }
                        }

                        Rectangle {
                            height: wifi.rows-shown * wifi.row-h + 2px;
                            border-radius: 10 * root.px;
                            border-width: 1px;
                            border-color: Theme.edge;
                            clip: true;
                            nets := ListView {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                                for net[i] in root.wifi-model: Rectangle {
                                    height: wifi.row-h;
                                    background: i == root.wifi-current ? Theme.accent-soft : ta.has-hover ? Theme.field : transparent;
                                    border-radius: 9 * root.px;
                                    border-width: i == root.wifi-current ? 2px : 0px;
                                    border-color: Theme.accent;
                                    if i < root.wifi-model.length - 1 && i != root.wifi-current && i + 1 != root.wifi-current: Rectangle {
                                        x: 12 * root.px;
                                        y: parent.height - 1px;
                                        width: parent.width - 24 * root.px;
                                        height: 1px;
                                        background: Theme.border;
                                    }
                                    HorizontalLayout {
                                        padding-left: 16 * root.px;
                                        padding-right: 16 * root.px;
                                        spacing: 14 * root.px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: net.ssid;
                                            color: Theme.text;
                                            font-size: 17 * root.px;
                                            font-weight: i == root.wifi-current ? 600 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        // A lock for a network with a password. Words for an open one.
                                        if net.secure: VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 0;
                                            Icon {
                                                source: @image-url("icons/lock.svg");
                                                colorize: Theme.dim;
                                                size: 16 * root.px;
                                            }
                                        }
                                        if !net.secure: Text {
                                            horizontal-stretch: 0;
                                            text: "Open";
                                            color: Theme.dim;
                                            font-size: 14 * root.px;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 0;
                                            Bars {
                                                px: root.px;
                                                signal: net.signal;
                                            }
                                        }
                                    }

                                    ta := TouchArea {
                                        clicked => {
                                            root.wifi-current = i;
                                            root.wifi-password = "";
                                            if net.secure {
                                                password.focus();
                                            } else {
                                                wifi.focus();
                                            }
                                        }
                                    }
                                }
                            }

                            // No list yet: the shape of the rows during the search, else the result.
                            if root.wifi-model.length == 0 && root.wifi-busy: VerticalLayout {
                                alignment: start;
                                for i in 3: Rectangle {
                                    height: wifi.row-h;
                                    Rectangle {
                                        x: 16 * root.px;
                                        width: (150 + mod(i * 70, 110)) * root.px;
                                        height: 12 * root.px;
                                        border-radius: 6 * root.px;
                                        background: Theme.field;
                                    }
                                }
                            }
                            if root.wifi-model.length == 0 && !root.wifi-busy: Text {
                                text: root.wifi-status;
                                color: Theme.dim;
                                font-size: 16 * root.px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Open networks have no password: the field takes no space. It stays in the
                        // tree, so that the keys can focus it.
                        Rectangle {
                            height: wifi.needs-password() ? password.preferred-height : 0px;
                            password := Field {
                                visible: wifi.needs-password();
                                width: parent.width;
                                px: root.px;
                                dense: root.dense;
                                label: "Password";
                                label-width: root.inline-w;
                                text <=> root.wifi-password;
                                password: true;
                                placeholder: root.inline-w > 0 ? "" : "Password for " + (root.wifi-current >= 0 ? root.wifi-model[root.wifi-current].ssid : "");
                                watch: root.content-height;
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                            }
                        }

                        if root.error != "" || root.wifi-busy || (root.wifi-status != "" && root.wifi-model.length > 0): HorizontalLayout {
                            spacing: 16 * root.px;
                            Note {
                                px: root.px;
                                horizontal-stretch: 1;
                                error: root.error != "";
                                text: root.error != "" ? root.error : root.wifi-status;
                            }

                            if root.wifi-busy: VerticalLayout {
                                alignment: center;
                                width: 120 * root.px;
                                Bar {
                                    px: root.px;
                                    indeterminate: true;
                                }
                            }
                        }

                        PillButton {
                            reveal(y, h) => {
                                root.reveal(y, h);
                            }
                            px: root.px;
                            primary: true;
                            wide: true;
                            text: "Connect  →";
                            enabled: root.wifi-current >= 0 && !root.wifi-busy;
                            clicked => {
                                root.wifi-connect();
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            skip-button := LinkButton {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                text: "Skip for now";
                                enabled: !root.wifi-busy;
                                clicked => {
                                    root.wifi-skip();
                                }
                            }
                        }
                    }
                }

                // 2: quick setup. One screen: username or @user, password, optional settings.
                // With Customize open the header and the help texts hide: the page fits without scrolling.
                if root.page == 2: VerticalLayout {
                    spacing: root.customize-open && !root.typing ? 12 * root.px : root.gap;
                    // Focus after the first layout: the username, or the password after a restart.
                    Timer {
                        interval: 1ms;
                        running: true;
                        triggered => {
                            self.running = false;
                            if root.account == "" {
                                account-field.focus();
                            } else {
                                password-field.focus();
                            }
                        }
                    }
                    // A git account filled the fields: the password is next, when the user is still in the account field.
                    property <int> filled: root.git-filled;
                    changed filled => {
                        if account-field.focused {
                            password-field.focus();
                        }
                    }

                    if !root.typing && !root.customize-open: VerticalLayout {
                        spacing: (root.dense ? 12 : 20) * root.px;
                        Logo {
                            logo: root.logo;
                            product: root.product;
                            size: root.logo-size;
                            limit: root.col-w;
                        }

                        Heading {
                            px: root.px;
                            small: root.dense;
                            title: "Quick setup";
                            subtitle: root.dense ? "" : "Create your account and finish the setup.";
                        }

                        HorizontalLayout {
                            alignment: center;
                            NetStatus {
                                px: root.px;
                                ip: root.ip-address;
                            }
                        }
                    }

                    account-field := Field {
                        px: root.px;
                        dense: root.dense;
                        label: "Username";
                        placeholder: root.ip-address != "" ? "username or @github-user" : "username";
                        help: root.typing || root.customize-open ? "" : "Use username for a local account or @username to import your GitHub profile.";
                        error-text: root.account-error;
                        text <=> root.account;
                        watch: root.content-height;
                        reveal(y, h) => {
                            root.reveal(y, h);
                        }
                        edited(t) => {
                            root.account-edited(t);
                        }
                        accepted => {
                            root.apply();
                        }
                    }

                    if root.git-title != "": GitCard {
                        px: root.px;
                        avatar: root.git-avatar;
                        has-avatar: root.git-has-avatar;
                        title: root.git-title;
                        detail: root.git-detail;
                        found: root.git-found;
                        warn: root.git-warn;
                        checking: root.git-checking;
                    }

                    password-field := Field {
                        px: root.px;
                        dense: root.dense;
                        label: "Password";
                        label-width: root.inline-w;
                        text <=> root.password;
                        password: true;
                        watch: root.content-height;
                        reveal(y, h) => {
                            root.reveal(y, h);
                        }
                        accepted => {
                            root.apply();
                        }
                    }

                    Field {
                        px: root.px;
                        dense: root.dense;
                        label: "Confirm password";
                        label-width: root.inline-w;
                        text <=> root.password2;
                        password: true;
                        // The two passwords are not the same.
                        invalid: root.password2 != "" && root.password2 != root.password;
                        error-text: self.invalid ? "The passwords are not the same." : "";
                        help: root.typing || root.customize-open ? "" : "This password is also the root password.";
                        watch: root.content-height;
                        reveal(y, h) => {
                            root.reveal(y, h);
                        }
                        accepted => {
                            root.apply();
                        }
                    }

                    // Optional settings: closed by default, with the values in one line.
                    Disclosure {
                        reveal(y, h) => {
                            root.reveal(y, h);
                        }
                        px: root.px;
                        text: "Customize";
                        summary: root.compact ? "" : root.summary;
                        open <=> root.customize-open;
                    }

                    if root.customize-open: VerticalLayout {
                        spacing: 12 * root.px;
                        HorizontalLayout {
                            spacing: 16 * root.px;
                            Field {
                                px: root.px;
                                dense: root.dense;
                                label: "Full name";
                                note: root.git-name != "" && root.realname == root.git-name ? "from " + root.git-source : "";
                                text <=> root.realname;
                                watch: root.content-height;
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                edited(t) => {
                                    root.realname-edited(t);
                                }
                                accepted => {
                                    root.apply();
                                }
                            }

                            Field {
                                px: root.px;
                                dense: root.dense;
                                label: "Local username";
                                note: root.git-username != "" && root.username == root.git-username ? "from " + root.git-source : "";
                                text <=> root.username;
                                watch: root.content-height;
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                edited(t) => {
                                    root.username-edited(t);
                                }
                                accepted => {
                                    root.apply();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16 * root.px;
                            SettingRow {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                label: "Time zone";
                                value: root.timezone;
                                clicked => {
                                    root.region-tab = 0;
                                    root.change-region();
                                }
                            }

                            SettingRow {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                label: "Language";
                                value: root.locale;
                                clicked => {
                                    root.region-tab = 1;
                                    root.change-region();
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 16 * root.px;
                            if root.has-zsh: HorizontalLayout {
                                horizontal-stretch: 1;
                                spacing: 12 * root.px;
                                padding-left: 8 * root.px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Shell";
                                    color: Theme.dim;
                                    font-size: 15 * root.px;
                                    vertical-alignment: center;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Segmented {
                                        px: root.px;
                                        options: ["bash", "zsh"];
                                        value <=> root.shell;
                                    }
                                }
                            }
                            SettingRow {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                label: "Keyboard";
                                value: root.keyboard;
                                clicked => {
                                    root.region-tab = 2;
                                    root.change-region();
                                }
                            }
                        }

                        if root.git-found && (root.git-keys > 0 || root.git-dotfiles-url != ""): HorizontalLayout {
                            spacing: 16 * root.px;
                            if root.git-keys > 0: CheckRow {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                text: root.git-keys == 1 ? "Import 1 SSH key" : "Import " + root.git-keys + " SSH keys";
                                detail: root.git-keys-url;
                                checked <=> root.import-keys;
                            }
                            if root.git-dotfiles-url != "": CheckRow {
                                reveal(y, h) => {
                                    root.reveal(y, h);
                                }
                                px: root.px;
                                text: "Apply armbian-dotfiles";
                                detail: root.git-dotfiles-url;
                                checked <=> root.import-dotfiles;
                            }
                        }
                    }

                    if root.error != "" || root.dry-run: Note {
                        px: root.px;
                        error: root.error != "";
                        dot: root.dry-run ? Theme.warning : transparent;
                        text: root.error != "" ? root.error : "Dry run: the settings go to a file only.";
                    }

                    PillButton {
                        reveal(y, h) => {
                            root.reveal(y, h);
                        }
                        px: root.px;
                        primary: true;
                        wide: true;
                        text: "Set up  →";
                        enabled: root.can-apply && root.password != "" && root.password == root.password2;
                        clicked => {
                            root.apply();
                        }
                    }
                }

                // 3: region. One list shows at a time. The three values stay in view.
                // Enter: Done (a search without a pick takes the best match). Escape: Cancel.
                if root.page == 3: VerticalLayout {
                    spacing: root.gap;
                    if !root.typing: Heading {
                        px: root.px;
                        small: true;
                        title: root.keyboard-only ? "Choose your keyboard" : "Region and keyboard";
                        subtitle: root.keyboard-only && !root.dense ? "You type the Wi-Fi password with this keyboard." : "";
                    }

                    region := FocusScope {
                        focus-on-click: false;
                        vertical-stretch: 1;
                        min-height: (root.typing ? 140 : 260) * root.px;
                        property <bool> side: root.dense && (!root.screen-keyboard-visible || !root.compact);
                        property <length> gap: (root.typing ? 8 : root.dense ? 12 : 16) * root.px;
                        property <length> tab-h: (root.typing ? 44 : root.dense ? 54 : 72) * root.px;
                        property <length> tab-w: self.side ? 220 * root.px : (self.width - 2 * self.gap) / 3;
                        property <length> list-x: root.keyboard-only ? 0px : self.side ? self.tab-w + self.gap : 0px;
                        property <length> list-y: root.keyboard-only ? 0px : self.side ? 0px : self.tab-h + self.gap;
                        // The search of the list that closes must not stay in Rust.
                        function show(tab: int) {
                            if tab == root.region-tab || root.keyboard-only {
                                return;
                            }
                            if root.region-tab == 0 {
                                root.search-tz("");
                            } else if root.region-tab == 1 {
                                root.search-locale("");
                            } else {
                                root.search-kb("");
                            }
                            root.region-tab = max(0, min(2, tab));
                        }
                        // Before the widgets: the lists use Enter themselves.
                        capture-key-pressed(event) => {
                            if event.text == Key.Escape {
                                root.region-cancel();
                                return accept;
                            }
                            if event.text == Key.Return {
                                root.region-done();
                                return accept;
                            }
                            return reject;
                        }
                        // Focus after the first layout: not in init.
                        Timer {
                            interval: 1ms;
                            running: true;
                            triggered => {
                                self.running = false;
                                if root.keyboard-only {
                                    root.region-tab = 2;
                                } else {
                                    tabs.focus();
                                }
                            }
                        }

                        Rectangle {
                            // Up and Down, or Left and Right, change the list.
                            tabs := FocusScope {
                                focus-on-click: false;
                                visible: !root.keyboard-only;
                                x: 0px;
                                y: 0px;
                                width: region.side ? region.tab-w : parent.width;
                                height: region.side ? parent.height : region.tab-h;
                                key-pressed(event) => {
                                    if event.text == Key.UpArrow || event.text == Key.LeftArrow {
                                        region.show(root.region-tab - 1);
                                        return accept;
                                    }
                                    if event.text == Key.DownArrow || event.text == Key.RightArrow {
                                        region.show(root.region-tab + 1);
                                        return accept;
                                    }
                                    return reject;
                                }
                                RegionTab {
                                    x: 0px;
                                    y: 0px;
                                    width: region.tab-w;
                                    height: region.tab-h;
                                    px: root.px;
                                    dense: root.dense;
                                    label: "Time zone";
                                    value: root.timezone;
                                    active: root.region-tab == 0;
                                    focused: tabs.has-focus;
                                    clicked => {
                                        tabs.focus();
                                        region.show(0);
                                    }
                                }

                                RegionTab {
                                    x: region.side ? 0px : 1 * (region.tab-w + region.gap);
                                    y: region.side ? 1 * (region.tab-h + 6 * root.px) : 0px;
                                    width: region.tab-w;
                                    height: region.tab-h;
                                    px: root.px;
                                    dense: root.dense;
                                    label: "Language";
                                    value: root.locale;
                                    active: root.region-tab == 1;
                                    focused: tabs.has-focus;
                                    clicked => {
                                        tabs.focus();
                                        region.show(1);
                                    }
                                }

                                RegionTab {
                                    x: region.side ? 0px : 2 * (region.tab-w + region.gap);
                                    y: region.side ? 2 * (region.tab-h + 6 * root.px) : 0px;
                                    width: region.tab-w;
                                    height: region.tab-h;
                                    px: root.px;
                                    dense: root.dense;
                                    label: "Keyboard";
                                    value: root.keyboard;
                                    active: root.region-tab == 2;
                                    focused: tabs.has-focus;
                                    clicked => {
                                        tabs.focus();
                                        region.show(2);
                                    }
                                }
                            }

                            if root.region-tab == 0: PickList {
                                x: region.list-x;
                                y: region.list-y;
                                width: parent.width - region.list-x;
                                height: parent.height - region.list-y;
                                px: root.px;
                                dense: root.dense;
                                placeholder: "Search a time zone";
                                model: root.tz-model;
                                current: root.tz-current;
                                search(t) => {
                                    root.search-tz(t);
                                }
                                picked(i) => {
                                    root.pick-tz(i);
                                }
                            }
                            if root.region-tab == 1: PickList {
                                x: region.list-x;
                                y: region.list-y;
                                width: parent.width - region.list-x;
                                height: parent.height - region.list-y;
                                px: root.px;
                                dense: root.dense;
                                placeholder: "Search a language";
                                model: root.locale-model;
                                current: root.locale-current;
                                search(t) => {
                                    root.search-locale(t);
                                }
                                picked(i) => {
                                    root.pick-locale(i);
                                }
                            }
                            if root.region-tab == 2: PickList {
                                x: region.list-x;
                                y: region.list-y;
                                width: parent.width - region.list-x;
                                height: parent.height - region.list-y;
                                px: root.px;
                                dense: root.dense;
                                placeholder: "Search a keyboard";
                                start-focus: root.keyboard-only;
                                model: root.kb-model;
                                current: root.kb-current;
                                search(t) => {
                                    root.search-kb(t);
                                }
                                picked(i) => {
                                    root.pick-kb(i);
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12 * root.px;
                        alignment: end;
                        PillButton {
                            reveal(y, h) => {
                                root.reveal(y, h);
                            }
                            px: root.px;
                            text: "Cancel";
                            clicked => {
                                root.region-cancel();
                            }
                        }

                        PillButton {
                            reveal(y, h) => {
                                root.reveal(y, h);
                            }
                            px: root.px;
                            primary: true;
                            text: "Done";
                            clicked => {
                                root.region-done();
                            }
                        }
                    }
                }

                // 4 with the log: after a failure, and for a dry run. Enter closes a dry run.
                if root.with-log: done := FocusScope {
                    vertical-stretch: 1;
                    key-pressed(event) => {
                        if event.text == Key.Return && root.finished {
                            root.finish();
                            return accept;
                        }
                        return reject;
                    }
                    Timer {
                        interval: 1ms;
                        running: true;
                        triggered => {
                            self.running = false;
                            done.focus();
                        }
                    }

                    VerticalLayout {
                        spacing: root.gap;
                        Logo {
                            logo: root.logo;
                            product: root.product;
                            size: root.logo-size;
                            limit: root.col-w;
                        }

                        Heading {
                            px: root.px;
                            small: true;
                            title: root.apply-title;
                            subtitle: root.apply-status;
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 120 * root.px;
                            background: Theme.field;
                            border-radius: 10 * root.px;
                            border-width: 1px;
                            border-color: Theme.border;
                            clip: true;
                            VerticalLayout {
                                padding: 16 * root.px;
                                Text {
                                    text: root.log;
                                    color: Theme.dim;
                                    font-size: 14 * root.px;
                                    font-family: "monospace";
                                    wrap: word-wrap;
                                    vertical-alignment: bottom;
                                }
                            }
                        }

                        if root.failed: PillButton {
                            reveal(y, h) => {
                                root.reveal(y, h);
                            }
                            px: root.px;
                            primary: true;
                            wide: true;
                            text: "Continue in text mode";
                            clicked => {
                                root.text-mode();
                            }
                        }
                    }
                }
            }
        }
    }

    // Small screens: a thin bar shows that the content scrolls. Drag or the wheel moves it.
    if flick.viewport-height > flick.height + 1px: Rectangle {
        x: root.width - 8px;
        y: -flick.viewport-y / flick.viewport-height * flick.height;
        width: 4px;
        height: flick.height * flick.height / flick.viewport-height;
        border-radius: 2px;
        background: Theme.edge;
    }

    if root.screen-keyboard-visible: VirtualKeyboard {
        y: root.content-height;
        width: root.width;
        height: root.screen-keyboard-height;
        px: root.px;
        accent: Theme.accent;
        key-pressed(key) => { root.screen-key(key); }
        dismissed => { TextInputInterface.text-input-focused = false; }
    }
}
