Use the update-notifier settings only when update-notifier is installed.
Debian has no update-notifier.

diff --git a/UpdateManager/UpdatesAvailable.py b/UpdateManager/UpdatesAvailable.py
index 8f1e2d6..717b6fa 100644
--- a/UpdateManager/UpdatesAvailable.py
+++ b/UpdateManager/UpdatesAvailable.py
@@ -378,10 +378,15 @@ class UpdatesAvailable(InternalDialog):
         )
 
         # If auto-updates are on, change cancel label
-        self.notifier_settings = Gio.Settings.new("com.ubuntu.update-notifier")
-        self.notifier_settings.connect(
-            "changed::auto-launch", lambda s, p: self.update_close_button()
-        )
+        # Armbian: update-notifier is optional. It owns this schema.
+        source = Gio.SettingsSchemaSource.get_default()
+        if source.lookup("com.ubuntu.update-notifier", True):
+            self.notifier_settings = Gio.Settings.new(
+                "com.ubuntu.update-notifier"
+            )
+            self.notifier_settings.connect(
+                "changed::auto-launch", lambda s, p: self.update_close_button()
+            )
         self.update_close_button()
 
         # Alert watcher
